# Panther X2 (RK3566) 内核片段 — 基于 arm64 defconfig 叠加
# 用法:
#   make ARCH=arm64 defconfig
#   ./scripts/kconfig/merge_config.sh -m .config kernel-config/panther-x2.fragment
#   make ARCH=arm64 olddefconfig
# 参考基线: ophub kernel-config config-6.18 (只筛代理/路由/SBC 实际需要项)
# GPU支持
CONFIG_DRM=y
CONFIG_DRM_PANFROST=y
CONFIG_DMA_SHARED_BUFFER=y


CONFIG_EXFAT_FS=y
CONFIG_NTFS3_FS=y
CONFIG_NTFS_FS=y

# ── btrfs-progs 配套（kmod-fs-btrfs + 全部依赖）──
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
# zstd/lzo/raid6/xor/xxhash/blake2b 由 BTRFS_FS select 自动带入，无需手写

# ── zram-swap ──
CONFIG_ZRAM=y

CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y
CONFIG_BPF_EVENTS=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_NET_INGRESS=y
CONFIG_NET_EGRESS=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_BPF=y
CONFIG_NET_CLS_ACT=y
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_IKHEADERS=y
CONFIG_HAVE_EBPF_JIT=y

# ── dnsmasq-full ──
CONFIG_NF_CONNTRACK_NETLINK=y

# ── ds-lite ──
CONFIG_IPV6=y
CONFIG_IPV6_TUNNEL=y

# ── install-emmc 的 bootfs（mkfs.vfat 之后要能挂载）──
CONFIG_VFAT_FS=y
CONFIG_NLS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y


# 明确关闭 NBD，避免因全内建被 olddefconfig 强制转成 =y
CONFIG_BLK_DEV_NBD=n

CONFIG_ARCH_ROCKCHIP=y
# --- 板级硬件 ---
# RK809 PMIC (供电树 + clkout1 提供 WiFi/BT 32.768K 时钟)
CONFIG_MFD_RK8XX=y
CONFIG_MFD_RK8XX_I2C=y
# 千兆网口 gmac1 (stmmac glue 层)
CONFIG_DWMAC_ROCKCHIP=y
# USB (dwc3 双角色;板上 usb_host0_xhci 为 host 模式)
CONFIG_USB_DWC3_DUAL_ROLE=y
# WiFi (brcmfmac SDIO;固件由 rootfs 提供)
CONFIG_BRCMFMAC=y
CONFIG_BRCMFMAC_SDIO=y
CONFIG_BRCMFMAC_USB=y

# --- tproxy 透明代理 (sing-box/mihomo,iptables 与 nftables 双栈) ---
CONFIG_NF_SOCKET_IPV4=y
CONFIG_NF_SOCKET_IPV6=y
CONFIG_NF_TPROXY_IPV4=y
CONFIG_NF_TPROXY_IPV6=y
CONFIG_NETFILTER_XT_MATCH_SOCKET=y
CONFIG_NETFILTER_XT_TARGET_TPROXY=y
CONFIG_NFT_SOCKET=y
CONFIG_NFT_TPROXY=y

# --- iptables (legacy xt) 常用项 ---
CONFIG_NF_NAT=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REDIRECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_NAT=y
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_NETFILTER_XT_TARGET_NETMAP=y
CONFIG_NETFILTER_XT_MATCH_STATE=y

# --- nftables 基础栈 (Debian 12 默认防火墙) ---
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NFT_QUEUE=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NF_CONNTRACK_MARK=y

# DNS 劫持 redirect / 分流 fib 表达式 (nexa/sing-box/mihomo 必需)
CONFIG_NFT_REDIR=y
CONFIG_NFT_REDIR_IPV4=y
CONFIG_NFT_REDIR_IPV6=y
CONFIG_NFT_REDIR_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y

# --- cgroup 分流 (v2) ---
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_NET_CLS_CGROUP=y

# --- 策略路由 (透明代理 fwmark 分流必需) ---
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_IP_ROUTE_CLASSID=y

# --- ipset (老规则/批量地址表) ---
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_NETFILTER_XT_SET=y

# --- 诊断 (ss -t/-u/-x 需要) ---
CONFIG_INET_UDP_DIAG=y
CONFIG_UNIX_DIAG=y
CONFIG_PACKET_DIAG=y
CONFIG_NETLINK_DIAG=y

# --- zram/zswap (低内存 swap 压缩) ---
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y
CONFIG_ZRAM_MULTI_COMP=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y

# --- 容器/虚拟网络模式 (docker macvlan/ipvlan/vxlan) ---
CONFIG_MACVLAN=y
CONFIG_MACVTAP=y
CONFIG_IPVLAN=y
CONFIG_IPVTAP=y
CONFIG_VXLAN=y

# --- SMB 服务器 (可选,不装 samba 服务可删) ---
CONFIG_KSMBD=y

# --- QoS 限速 (可选,不用 sqm 可删) ---
CONFIG_NET_SCH_CAKE=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_FQ=y

# --- BBR 拥塞控制 (99-bbr.conf 需要;defconfig 默认只有 cubic) ---
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y

# --- WireGuard / 常用防火墙 match (对齐 ophub 功能集) ---
CONFIG_WIREGUARD=y
CONFIG_CRYPTO_AES_ARM64_CE=y
CONFIG_CRYPTO_CHACHA20POLY1305=y
CONFIG_NETFILTER_XT_MATCH_CGROUP=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# --- THP 默认 madvise 模式 (choice 三选一,必须显式关 ALWAYS) ---
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=n

# --- 按需扩展: IPsec / IPVS / ebtables / KVM / NAS / 国密 / flow offload ---
# IPsec (strongswan/setkey 需要)
CONFIG_NET_KEY=y
CONFIG_XFRM_USER=y
CONFIG_INET_ESP=y
CONFIG_INET_ESP_OFFLOAD=y
CONFIG_INET6_ESP=y
CONFIG_INET6_ESP_OFFLOAD=y
# KVM (覆盖 slim 的 VIRTUALIZATION=n)
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
# NAS 客户端 (挂 NFS/SMB 共享)
CONFIG_NFS_FS=y
CONFIG_CIFS=y
# 加速
CONFIG_CRYPTO_DEV_ROCKCHIP=y
