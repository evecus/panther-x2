# === PCI(e)(dts 未启用任何 pcie 节点;以后接 NVMe 要把这行删掉) ===
CONFIG_PCI=n

# === 杂项省资源 ===
# 注意: FW_LOADER 必须保持开启(brcmfmac 通过 request_firmware 加载固件),勿关
CONFIG_KEXEC=n
CONFIG_CRASH_DUMP=n
CONFIG_HIBERNATION=n
CONFIG_SUSPEND=n
CONFIG_ARM_PSCI_CPUIDLE=n
# 全内建: 不再产出 /lib/modules,板上安装更简单(fragment 里的 =m 会被强制转为 =y)
