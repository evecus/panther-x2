# === 无头设备: 关闭显示/音频/摄像头 ===
# 本机无屏幕无音频输出(i2s 在 dts 里也是 disabled),panfrost/DRM/ALSA/V4L2 全部无用
# 注意: 若以后要接屏幕或声卡,删掉对应行重编
CONFIG_DRM=n
