# ============================================================================
# 【条件组】板端确认后再启用：去掉行首一个 "#"（改回 y 就整行删掉）
# ============================================================================
## 板上若无 SPI NOR (cat /proc/mtd 为空) 可关；有则保留下面两行:
CONFIG_MTD=n
CONFIG_SPI_ROCKCHIP_SFC=n
## 确认 U-Boot 用 booti/extlinux（非 bootefi）启动后可关:
CONFIG_EFI=n
CONFIG_EFIVAR_FS=n
## DRM 已关闭的前提下（Rockchip IOMMU 只服务显示/媒体单元）:
CONFIG_IOMMU_SUPPORT=n
## 无风扇/背光可关 PWM 全家:
CONFIG_PWM=n
## 需要 USB-TTL 调试棒/4G 模块就保留；不用可关:
CONFIG_USB_SERIAL=n
CONFIG_USB_NET_CDC_NCM=n
## 追求 vmlinux 体积可关（代价: perf/bpftrace 无符号）:
CONFIG_DEBUG_INFO=n
## 国密算法，代理场景不用:
CONFIG_CRYPTO_LIB_SM3=n
CONFIG_CRYPTO_LIB_SM4=n
CONFIG_CRYPTO_SM4_GENERIC=n


